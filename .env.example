# Database
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/instagram_bot

# Redis
REDIS_URL=redis://redis:6379/0

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Meta / Instagram
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_page_access_token_here
META_VERIFY_TOKEN=your_webhook_verify_token_here
META_GRAPH_API_URL=https://graph.facebook.com/v21.0

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_GROUP_ID=-100xxxxxxxxxx

# Admin API
API_SECRET_KEY=your_strong_random_api_key_here

# CORS (comma-separated origins for Lovable admin panel)
CORS_ORIGINS=https://your-lovable-app.lovable.app

# App settings
ENVIRONMENT=production
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=botuser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=instagram_bot

# Constructed automatically by docker-compose — usually no need to set manually
DATABASE_URL=postgresql+asyncpg://botuser:change_me_strong_password@postgres:5432/instagram_bot

# ──────────────────────────────────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ──────────────────────────────────────────────────────────────────────────────
# Google Gemini
# ──────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ──────────────────────────────────────────────────────────────────────────────
# Meta / Instagram
# ──────────────────────────────────────────────────────────────────────────────
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_page_access_token_here
META_VERIFY_TOKEN=your_webhook_verify_token_here
META_GRAPH_API_URL=https://graph.facebook.com/v21.0

# ──────────────────────────────────────────────────────────────────────────────
# Telegram
# ──────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_GROUP_ID=-100xxxxxxxxxx

# ──────────────────────────────────────────────────────────────────────────────
# Auth / Security
# ──────────────────────────────────────────────────────────────────────────────
# Used to protect all admin API endpoints (X-API-Key header)
API_SECRET_KEY=generate_a_long_random_string_here

# JWT settings for the admin panel login
JWT_SECRET_KEY=generate_another_long_random_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ──────────────────────────────────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the admin panel
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ──────────────────────────────────────────────────────────────────────────────
# Frontend (passed as a Docker build arg to Vite)
# Leave empty to use relative /api/v1 paths (works behind nginx)
# ──────────────────────────────────────────────────────────────────────────────
VITE_API_URL=

# ──────────────────────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# Instagram daily message limits
IG_DAILY_MESSAGE_LIMIT=1000
IG_DAILY_WARNING_THRESHOLD=900
